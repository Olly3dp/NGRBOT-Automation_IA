<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - NGR Bot</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { ngr: { black: '#000000', gold: '#D4AF37', crimson: '#5A0F1C', dark: '#0a0a0a' } },
          fontFamily: { sans: ['Inter', 'sans-serif'] }
        }
      }
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: #000; color: #fff; }
    .sidebar { background: linear-gradient(180deg, #0a0a0a, #151515); }
    .card-g { background: linear-gradient(145deg, #0a0a0a, #151515); }
    .text-gold { color: #D4AF37; }
    .bg-crimson { background-color: #5A0F1C; }
    .badge-premium { background: linear-gradient(135deg, #D4AF37, #F5D76E); }
    .badge-pending { background: linear-gradient(135deg, #f59e0b, #fbbf24); }
    .badge-admin { background: linear-gradient(135deg, #5A0F1C, #7a1525); }
    .nav-active { background: rgba(212,175,55,0.1); color: #D4AF37; border-color: rgba(212,175,55,0.3); }
    .connected-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 6px; }
  </style>
</head>
<body class="min-h-screen">
  <div class="flex min-h-screen">
    <aside class="sidebar w-64 border-r border-yellow-500/20 fixed h-full z-40 hidden md:flex flex-col">
      <div class="p-5 border-b border-yellow-500/20">
        <div class="flex items-center gap-2">
          <span class="text-xl">🤖</span>
          <span class="text-lg font-bold text-gold">NGR BOT</span>
        </div>
      </div>
      <div class="p-5 border-b border-yellow-500/20">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-full bg-yellow-500/20 flex items-center justify-center overflow-hidden">
            <% if (user.avatar_url) { %>
              <img src="<%= user.avatar_url %>" alt="Avatar" class="w-full h-full object-cover" id="userAvatarImg">
            <% } else { %>
              <span class="text-lg" id="userAvatarIcon">👤</span>
            <% } %>
          </div>
          <div>
            <p class="font-medium text-sm" id="userName"><%= user.name %></p>
            <p class="text-xs text-gray-500" id="userEmail"><%= user.email %></p>
          </div>
        </div>
        <div id="statusBadge" class="mt-3"></div>
      </div>
      <nav class="flex-1 p-4">
        <ul class="space-y-1.5">
          <li><a href="#" class="nav-item flex items-center gap-3 px-4 py-2.5 rounded-xl nav-active text-sm" data-page="connection"><span>📱</span><span>Conexão</span></a></li>
          <li><a href="#" class="nav-item flex items-center gap-3 px-4 py-2.5 rounded-xl text-gray-400 hover:bg-white/5 text-sm" data-page="config"><span>⚙️</span><span>Configurações do Bot</span></a></li>
          <li><a href="#" class="nav-item flex items-center gap-3 px-4 py-2.5 rounded-xl text-gray-400 hover:bg-white/5 text-sm" data-page="plans"><span>💎</span><span>Planos</span></a></li>
          <li><a href="#" class="nav-item flex items-center gap-3 px-4 py-2.5 rounded-xl text-gray-400 hover:bg-white/5 text-sm" data-page="account"><span>👤</span><span>Minha Conta</span></a></li>
        </ul>
      </nav>
      <div class="p-4 border-t border-yellow-500/20">
        <button onclick="logout()" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-gray-400 hover:bg-red-500/10 hover:text-red-400 transition w-full text-sm"><span>🚪</span><span>Sair</span></button>
      </div>
    </aside>

    <main class="flex-1 md:ml-64">
      <header class="md:hidden bg-dark border-b border-yellow-500/20 p-3 flex items-center justify-between">
        <div class="flex items-center gap-2"><span class="text-lg">🤖</span><span class="font-bold text-gold text-sm">NGR BOT</span></div>
        <button onclick="logout()" class="text-gray-400 text-sm"><span>🚪</span></button>
      </header>
      <div class="p-5" id="mainContent">
        <div id="pageLoading" class="flex items-center justify-center h-64">
          <div class="text-center">
            <div class="w-8 h-8 border-4 border-yellow-500/30 border-t-yellow-500 rounded-full animate-spin mx-auto mb-3"></div>
            <p class="text-gray-400 text-sm">Carregando...</p>
          </div>
        </div>
        <div id="pageConnection" class="hidden"></div>
        <div id="pagePlans" class="hidden"></div>
        <div id="pageConfig" class="hidden">
          <div class="mb-5"><h1 class="text-lg font-bold">Configurações do Bot</h1><p class="text-gray-400 text-sm">Configure sua chave Groq, personalidade e fluxos automáticos</p></div>
          
          <% if (user.isSmartPlan) { %>
          <!-- IA Blocada para Plano Smart -->
          <div class="card-g rounded-xl border border-red-500/30 p-5 mb-4 bg-red-500/5">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-sm font-bold text-white">🤖 Inteligência Artificial</h3>
                <p class="text-xs text-gray-400">Recurso exclusivo do plano PRO AI</p>
              </div>
              <span class="bg-red-500/20 text-red-400 text-xs px-2 py-1 rounded">Bloqueado</span>
            </div>
            <div class="mt-3 pt-3 border-t border-red-500/20">
              <a href="/plans" class="text-sm text-yellow-400 hover:text-yellow-300 font-medium">Fazer upgrade para PRO AI</a>
            </div>
          </div>
          <% } else { %>
          <!-- Toggle IA Ativa -->
          <div class="card-g rounded-xl border border-yellow-500/20 p-5 mb-4">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-sm font-bold text-white">🤖 IA Ativa</h3>
                <p class="text-xs text-gray-400">Quando ativado, o bot usa a Groq para responder automaticamente</p>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="aiActive" class="sr-only peer" <%= user.ai_active ? 'checked' : '' %>>
                <div class="w-11 h-6 bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-green-500"></div>
              </label>
            </div>
          </div>

          <!-- Configurações da IA -->
          <div class="card-g rounded-xl border border-yellow-500/20 p-5 mb-4">
            <h3 class="text-sm font-bold text-white mb-3">🔑 Configurações da IA</h3>
            <div class="space-y-4">
              <div>
                <label class="block text-xs text-gray-400 mb-1.5">Chave API Groq</label>
                <input type="password" id="groqKey" value="<%= user.groq_key || '' %>" placeholder="gsk_..." class="w-full bg-black/50 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:border-yellow-500 focus:outline-none">
              </div>
              <div>
                <label class="block text-xs text-gray-400 mb-1.5">Modelo de IA</label>
                <select id="selectedModel" class="w-full bg-black/50 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:border-yellow-500 focus:outline-none">
                  <option value="llama-3.1-8b-instant" <%= user.selected_model === 'llama-3.1-8b-instant' ? 'selected' : '' %>>⚡ Velocidade (Llama 3.1 8B)</option>
                  <option value="llama-3.3-70b-versatile" <%= user.selected_model === 'llama-3.3-70b-versatile' ? 'selected' : '' %>>🧠 Raciocínio (Llama 3.3 70B)</option>
                </select>
              </div>
              <div>
                <label class="block text-xs text-gray-400 mb-1.5">Prompt do Sistema (Personalidade)</label>
                <textarea id="aiPrompt" rows="3" placeholder="Você é um assistente da NG Ruby..." class="w-full bg-black/50 border border-gray-700 rounded-lg px-3 py-2.5 text-white text-sm focus:border-yellow-500 focus:outline-none"><%= user.ai_prompt || '' %></textarea>
                <a href="https://console.groq.com/" target="_blank" class="inline-block mt-2 bg-yellow-500 hover:bg-yellow-400 text-black font-bold px-4 py-2 rounded-lg text-xs transition">Obter Chave API no Groq</a>
              </div>
            </div>
          </div>
          <% } %>

          <!-- Fluxos Automáticos -->
          <div class="card-g rounded-xl border border-yellow-500/20 p-5 mb-4">
            <h3 class="text-sm font-bold text-white mb-3">🔄 Fluxos de Resposta Automática</h3>
            <p class="text-xs text-gray-400 mb-3">Configure palavras-chave e respostas automáticas (prioridade sobre a IA)</p>
            <div id="flowsContainer" class="space-y-3">
            </div>
            <button onclick="addFlow()" class="mt-3 text-xs text-yellow-400 hover:text-yellow-300 flex items-center gap-1">
              <span>+ Adicionar Fluxo</span>
            </button>
          </div>

          <button onclick="saveAI()" id="btnSaveAI" class="bg-crimson hover:bg-red-700 px-5 py-2.5 rounded-lg text-sm font-medium transition flex items-center gap-2">
            <span id="btnSaveAIText">Salvar Todas as Configurações</span>
            <span id="btnSaveAISpinner" class="hidden"><svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg></span>
          </button>
        </div>
        <div id="pageAccount" class="hidden"></div>
        <div id="pagePayment" class="hidden"></div>
      </div>
    </main>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const SERVER_USER = <%- JSON.stringify(user) %>;
    const ADMIN_EMAIL = <%- JSON.stringify(adminEmail || '') %>;
    let socket, userId = SERVER_USER.id;
    let isAdmin = SERVER_USER.email === ADMIN_EMAIL;
    let isTrial = false;
    let currentPage = 'connection';
    let qrTimeout = null;
    let notificationTimeout = null;

    async function init() {
      try {
        socket = io({ transports: ['polling', 'websocket'], timeout: 5000, forceNew: true });
        socket.on('connect', function() {
          console.log('[Socket] Conectado, ID:', socket.id);
          socket.emit('join-user', userId);
        });
        socket.on('connect_error', function(err) {
          console.error('[Socket] Erro conexao:', err.message);
        });
        socket.on('qr', function(qrData) {
          if (qrTimeout) { clearTimeout(qrTimeout); qrTimeout = null; }
          try { showQR(qrData); } catch(e) { console.error('[QR] Erro:', e); }
        });
        socket.on('status', function(status) {
          try { updateStatus(status); } catch(e) { console.error('[Status] Erro:', e); }
        });

        await checkSubscription();
      } catch (err) {
        console.error('[Init] Erro:', err.message);
        var loading = document.getElementById('pageLoading');
        if (loading) loading.innerHTML = '<div class="text-center py-10"><p class="text-red-400 text-sm">Erro ao carregar. <button onclick="location.reload()" class="text-yellow-400 underline">Tentar novamente</button></p></div>';
      }
    }

    async function checkStatus() {
      try {
        var res = await fetch('/api/whatsapp/status');
        return await res.json();
      } catch(e) {
        return { connected: false };
      }
    }

    async function checkSubscription() {
      try {
        var res = await fetch('/api/subscription/status');
        if (!res.ok) {
          if (res.status === 401) {
            window.location.href = '/login';
            return;
          }
          throw new Error('Erro na requisição: ' + res.status);
        }
        var subData = await res.json();
        console.log('[checkSubscription] Resposta:', JSON.stringify(subData));
        isAdmin = subData.isAdmin || isAdmin;
        isTrial = subData.isTrial || false;
        console.log('[checkSubscription] isTrial:', isTrial);
        renderDashboard(subData, SERVER_USER, isTrial);
      } catch (err) {
        console.error('[checkSubscription] Erro:', err.message);
        isAdmin = SERVER_USER.email === ADMIN_EMAIL;
        renderDashboard({ isActive: isAdmin }, SERVER_USER, false);
      }
    }

    function renderDashboard(subData, userData, isTrial) {
      window.subData = subData || {};
      document.getElementById('userName').textContent = userData.name;
      document.getElementById('userEmail').textContent = userData.email;
      var badge = document.getElementById('statusBadge');
      
      if (isAdmin) {
        badge.innerHTML = '<div class="badge-admin px-3 py-1 rounded-full text-xs font-bold text-white flex items-center gap-1"><span>⭐</span> ASSINATURA PREMIUM (ADMIN)</div>';
      } else if (subData.trialExpired) {
        badge.innerHTML = '<div class="badge-pending px-3 py-1 rounded-full text-xs font-bold text-black flex items-center gap-1"><span>⚠️</span> PERÍODO EXPIRADO</div>';
        // Mostrar alerta de trial expirado
        alert('Seu período de teste gratuito acabou. Escolha um plano para continuar usando o NGR BOT.');
      } else if (isTrial) {
        var daysLeft = subData.daysRemaining || 7;
        badge.innerHTML = '<div class="badge-premium px-3 py-1 rounded-full text-xs font-bold text-black flex items-center gap-1"><span>🆓</span> PERÍODO GRÁTIS (' + daysLeft + ' dias)</div>';
      } else if (subData.isActive) {
        badge.innerHTML = '<div class="badge-premium px-3 py-1 rounded-full text-xs font-bold text-black flex items-center gap-1"><span>✓</span> PLANO ATIVO</div>';
      } else {
        badge.innerHTML = '<div class="badge-pending px-3 py-1 rounded-full text-xs font-bold text-black flex items-center gap-1"><span>⏳</span> PAGAMENTO PENDENTE</div>';
      }
      
      var hasAccess = subData.isActive || isAdmin || isTrial;
      if (subData.trialExpired) {
        hasAccess = false;
      }
      renderPage(hasAccess, userData, isTrial, subData.trialExpired);
    }

    function renderPage(hasAccess, userData, isTrial, trialExpired) {
      // Fallback para variável global se parâmetro não for passado
      if (typeof isTrial === 'undefined') {
        isTrial = window.isTrial || false;
      }
      if (typeof trialExpired === 'undefined') {
        trialExpired = false;
      }
      console.log('[renderPage] hasAccess:', hasAccess, 'isAdmin:', isAdmin, 'isTrial:', isTrial, 'trialExpired:', trialExpired);
      var pageIds = ['pageLoading', 'pageConnection', 'pagePlans', 'pageConfig', 'pageAccount', 'pagePayment'];
      for (var i = 0; i < pageIds.length; i++) {
        var el = document.getElementById(pageIds[i]);
        if (el) el.classList.add('hidden');
      }
      // Trial users always have access (unless expired)
      if (trialExpired) {
        // Redirecionar para página de planos
        currentPage = 'plans';
        var plansPage = document.getElementById('pagePlans');
        plansPage.classList.remove('hidden');
        plansPage.innerHTML = plansHTMLExpired();
        return;
      }
      if (isTrial) {
        hasAccess = true;
      }
      if (!hasAccess && !isAdmin) {
        console.log('[renderPage] Mostrando pagina de pagamento');
        var pay = document.getElementById('pagePayment');
        pay.classList.remove('hidden');
        pay.innerHTML = paymentHTML();
        return;
      }
      if (isTrial && currentPage === 'payment') {
        currentPage = 'connection';
      }
      switch(currentPage) {
        case 'connection':
          document.getElementById('pageConnection').classList.remove('hidden');
          loadConnectionPage();
          break;
        case 'config':
          document.getElementById('pageConfig').classList.remove('hidden');
          renderFlows();
          break;
        case 'plans':
          document.getElementById('pagePlans').classList.remove('hidden');
          document.getElementById('pagePlans').innerHTML = plansHTML();
          break;
        case 'account':
          document.getElementById('pageAccount').classList.remove('hidden');
          document.getElementById('pageAccount').innerHTML = accountHTML(userData);
          break;
        default:
          document.getElementById('pageConnection').classList.remove('hidden');
          loadConnectionPage();
      }
    }

    function showNotification(msg, type) {
      var existing = document.getElementById('notification');
      if (existing) existing.remove();
      var bg = type === 'success' ? 'bg-green-600' : 'bg-red-600';
      var div = document.createElement('div');
      div.id = 'notification';
      div.className = 'fixed top-5 right-5 z-50 ' + bg + ' text-white px-5 py-3 rounded-xl shadow-lg text-sm font-medium transition-all duration-300';
      div.textContent = msg;
      document.body.appendChild(div);
      if (notificationTimeout) clearTimeout(notificationTimeout);
      notificationTimeout = setTimeout(function() { 
        div.style.opacity = '0'; 
        setTimeout(function() { div.remove(); }, 300); 
      }, 3000);
    }

    async function loadConnectionPage() {
      var container = document.getElementById('pageConnection');
      container.innerHTML = connectHTML(window.subData || {});
      var status = await checkStatus();
      if (status.connected) {
        var el = document.getElementById('qrStatus');
        if (el) el.innerHTML = '<p class="text-green-400 text-sm">WhatsApp conectado!</p>';
        var waText = document.getElementById('waStatusText');
        if (waText) { waText.textContent = 'Conectado'; waText.className = 'text-green-400 font-medium text-sm'; }
      } else if (status.connecting) {
        var el = document.getElementById('qrStatus');
        if (el) el.innerHTML = '<p class="text-yellow-400 animate-pulse text-sm">Conectando... Aguarde o QR Code</p>';
      }
    }

    function connectHTML(subData) {
      subData = subData || {};
      var planName = subData.planName || (isAdmin ? 'Admin Premium' : (isTrial ? 'Trial - 7 dias grátis' : 'Plano Free'));
      var daysRemaining = subData.daysRemaining !== undefined ? subData.daysRemaining : (isTrial ? 7 : 0);
      var isActive = subData.isActive !== undefined ? subData.isActive : false;
      var isTrialUser = isTrial || (subData.isTrial === true);
      var validText;
      
      if (isAdmin) {
        validText = 'Indefinido';
      } else if (isTrialUser) {
        validText = daysRemaining + ' dias (Trial)';
      } else if (isActive) {
        validText = daysRemaining + ' dias restantes';
      } else {
        validText = 'Plano Free';
      }
      
      return '<div class="mb-5"><h1 class="text-lg font-bold">Conexão WhatsApp</h1><p class="text-gray-400 text-sm">Gerencie a conexão do seu WhatsApp</p></div>' +
        '<div class="grid lg:grid-cols-2 gap-4">' +
        '<div class="card-g rounded-xl border border-yellow-500/20 p-5">' +
        '<h2 class="text-sm font-bold mb-3 flex items-center gap-2"><span>📱</span> WhatsApp</h2>' +
        '<div id="qrContainer" class="text-center py-6">' +
        '<div class="qr-status bg-yellow-500/10 border border-yellow-500/30 rounded-xl p-4 inline-block" id="qrStatus">' +
        '<p class="text-yellow-400 text-sm">Clique em "Conectar" para gerar o QR Code</p>' +
        '</div></div>' +
        '<div class="flex gap-3 mt-3">' +
        '<button onclick="connectWA()" id="btnConnect" class="flex-1 bg-crimson hover:bg-red-700 px-4 py-2.5 rounded-xl text-sm font-medium transition">Conectar WhatsApp</button>' +
        '<button onclick="disconnectWA()" class="bg-gray-800 hover:bg-gray-700 px-4 py-2.5 rounded-xl text-sm font-medium transition text-gray-300">Desconectar</button>' +
        '</div></div>' +
        '<div class="card-g rounded-xl border border-yellow-500/20 p-5">' +
        '<h2 class="text-sm font-bold mb-3 flex items-center gap-2"><span>📊</span> Status da Conta</h2>' +
        '<div class="space-y-3">' +
        '<div class="flex justify-between items-center p-3 bg-black/30 rounded-lg text-sm"><span class="text-gray-400">Plano</span><span class="text-gold font-medium text-sm">' + planName + '</span></div>' +
        '<div class="flex justify-between items-center p-3 bg-black/30 rounded-lg text-sm"><span class="text-gray-400">Validade</span><span class="text-white font-medium text-sm">' + validText + '</span></div>' +
        '<div class="flex justify-between items-center p-3 bg-black/30 rounded-lg text-sm"><span class="text-gray-400">WhatsApp</span><span class="text-gray-400 text-sm" id="waStatusText">Desconectado</span></div>' +
        '</div></div></div>';
    }

    function plansHTML() {
      return '<div class="mb-5"><h1 class="text-lg font-bold">Planos e Assinatura</h1><p class="text-gray-400 text-sm">Escolha o plano ideal para seu negócio</p></div>' +
        '<div class="grid md:grid-cols-2 gap-5">' +
        // Plan Fluxos
        '<div class="card-g rounded-xl border border-gray-600/30 p-5">' +
        '<div class="text-center mb-4">' +
        '<h3 class="text-base font-bold text-white">NGR Fluxos</h3>' +
        '<p class="text-gray-500 text-xs">Automação sem IA</p>' +
        '</div>' +
        '<div class="text-center mb-4">' +
        '<span class="text-3xl font-bold text-gold">R$ 27,90</span><span class="text-xs text-gray-400">/mês</span>' +
        '</div>' +
        '<div class="text-left text-xs text-gray-400 mb-4 space-y-2">' +
        '<div class="flex items-center gap-2"><span class="text-green-400">✓</span><span>Dashboard completo</span></div>' +
        '<div class="flex items-center gap-2"><span class="text-green-400">✓</span><span>Fluxos automatizados</span></div>' +
        '<div class="flex items-center gap-2"><span class="text-green-400">✓</span><span>Menu automático</span></div>' +
        '<div class="flex items-center gap-2"><span class="text-green-400">✓</span><span>Multi-contas WhatsApp</span></div>' +
        '<div class="flex items-center gap-2"><span class="text-gray-500">✗</span><span class="text-gray-500">Inteligência Artificial</span></div>' +
        '</div>' +
        '<button onclick="subscribe(\'fluxos\')" class="w-full border-2 border-yellow-500 text-yellow-400 hover:bg-yellow-500/10 py-3 rounded-xl font-bold text-sm transition">Escolher Fluxos</button>' +
        '</div>' +
        // Plan Pro
        '<div class="card-g rounded-xl border border-yellow-500/40 p-5 relative">' +
        '<div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-yellow-500 text-black text-[10px] font-bold px-3 py-1 rounded-full">MAIS POPULAR</div>' +
        '<div class="text-center mb-4">' +
        '<h3 class="text-base font-bold text-white">NGR Pro (IA)</h3>' +
        '<p class="text-gray-500 text-xs">Automação + IA Avançada</p>' +
        '</div>' +
        '<div class="text-center mb-4">' +
        '<span class="text-3xl font-bold text-gold">R$ 56,90</span><span class="text-xs text-gray-400">/mês</span>' +
        '</div>' +
        '<div class="text-left text-xs text-gray-400 mb-4 space-y-2">' +
