    function showQR(qrData) {
      var container = document.getElementById('qrContainer');
      var status = document.getElementById('qrStatus');
      if (!container || !status) return;
      document.getElementById('qrContainer').innerHTML = '';
      if (qrData === 'loading') {
        status.innerHTML = '<p class="text-yellow-400 animate-pulse text-sm">Aguarde... Gerando QR Code</p>';
      } else if (qrData) {
        var img = document.createElement('img');
        img.src = qrData;
        img.className = 'max-w-[200px] mx-auto rounded-lg border-2 border-yellow-500';
        img.alt = 'QR Code WhatsApp';
        container.appendChild(img);
        status.innerHTML = '<p class="text-green-400 mt-3 text-sm">Escaneie com seu WhatsApp</p>';
      } else {
        status.innerHTML = '<p class="text-green-400 text-sm">WhatsApp conectado!</p>';
      }
    }

    function updateStatus(status) {
      var el = document.getElementById('qrStatus');
      var waText = document.getElementById('waStatusText');
      if (el) {
        if (status.connected) {
          el.innerHTML = '<p class="text-green-400 text-sm">WhatsApp conectado!</p>';
        } else if (status.connecting) {
          el.innerHTML = '<p class="text-yellow-400 animate-pulse text-sm">Conectando...</p>';
        } else {
          el.innerHTML = '<p class="text-gray-400 text-sm">' + (status.message || 'Desconectado') + '</p>';
        }
      }
      if (waText) {
        if (status.connected) {
          waText.textContent = 'Conectado';
          waText.className = 'text-green-400 font-medium text-sm';
        } else if (status.connecting) {
          waText.textContent = 'Conectando...';
          waText.className = 'text-yellow-400 font-medium text-sm';
        } else {
          waText.textContent = 'Desconectado';
          waText.className = 'text-gray-400 text-sm';
        }
      }
    }

    async function connectWA() {
      var btn = document.getElementById('btnConnect');
      var status = document.getElementById('qrStatus');
      if (!status) return;
      btn.disabled = true;
      btn.textContent = 'Conectando...';
      status.innerHTML = '<p class="text-yellow-400 animate-pulse text-sm">Iniciando conexao...</p>';
      try {
        var res = await fetch('/api/whatsapp/connect', { method: 'POST' });
        var data = await res.json();
        if (data.error) {
          status.innerHTML = '<p class="text-red-400 text-sm">Erro: ' + data.error + '</p>';
          btn.disabled = false;
          btn.textContent = 'Conectar WhatsApp';
          return;
        }
        if (data.alreadyConnected) {
          status.innerHTML = '<p class="text-green-400 text-sm">Ja conectado!</p>';
          btn.disabled = false;
          btn.textContent = 'Conectar WhatsApp';
          return;
        }
        if (data.connecting || data.success) {
          status.innerHTML = '<p class="text-yellow-400 animate-pulse text-sm">Aguardando QR Code...</p>';
          qrTimeout = setTimeout(function() {
            status.innerHTML = '<p class="text-red-400 text-sm">Tempo excedido. Tente novamente.</p>';
            btn.disabled = false;
            btn.textContent = 'Conectar WhatsApp';
          }, 30000);
        }
      } catch(e) {
        status.innerHTML = '<p class="text-red-400 text-sm">Erro de conexao com o servidor</p>';
        btn.disabled = false;
        btn.textContent = 'Conectar WhatsApp';
      }
    }

    var origShowQR = showQR;
    showQR = function(qrData) {
      var btn = document.getElementById('btnConnect');
      if (btn && qrData && qrData !== 'loading') {
        btn.disabled = false;
        btn.textContent = 'Conectar WhatsApp';
      }
      origShowQR(qrData);
    };

    async function disconnectWA() {
      if (!confirm('Tem certeza?')) return;
      try {
        await fetch('/api/whatsapp/disconnect', { method: 'POST' });
        var el = document.getElementById('qrStatus');
        if (el) el.innerHTML = '<p class="text-gray-400 text-sm">WhatsApp desconectado</p>';
        var container = document.getElementById('qrContainer');
        if (container) container.innerHTML = '';
      } catch(e) {}
    }

    function renderFlows() {
      var container = document.getElementById('flowsContainer');
      var flows = SERVER_USER.auto_flows || [];
      container.innerHTML = '';
      if (flows.length === 0) {
        container.innerHTML = '<p class="text-xs text-gray-500">Nenhum fluxo configurado. Clique em "+ Adicionar Fluxo" para começar.</p>';
      } else {
        for (var i = 0; i < flows.length; i++) {
          var flow = flows[i];
          var div = document.createElement('div');
          div.className = 'flex gap-2 items-start';
          div.innerHTML = '<input type="text" placeholder="Palavra-chave" value="' + escapeHtml(flow.keyword) + '" class="flow-key flex-1 bg-black/50 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm" style="max-width: 30%;">' +
            '<textarea placeholder="Resposta" class="flow-response flex-1 bg-black/50 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm" rows="2">' + escapeHtml(flow.response) + '</textarea>' +
            '<button onclick="removeFlow(this)" class="text-red-400 hover:text-red-300 px-2">✕</button>';
          container.appendChild(div);
        }
      }
    }

    function addFlow() {
      var container = document.getElementById('flowsContainer');
      var div = document.createElement('div');
      div.className = 'flex gap-2 items-start';
      div.innerHTML = '<input type="text" placeholder="Palavra-chave" class="flow-key flex-1 bg-black/50 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm" style="max-width: 30%;">' +
        '<textarea placeholder="Resposta" class="flow-response flex-1 bg-black/50 border border-gray-700 rounded-lg px-3 py-2 text-white text-sm" rows="2"></textarea>' +
        '<button onclick="removeFlow(this)" class="text-red-400 hover:text-red-300 px-2">✕</button>';
      container.appendChild(div);
    }

    function removeFlow(btn) {
      var div = btn.parentElement;
      var container = div.parentElement;
      container.removeChild(div);
      if (container.children.length === 0) {
        renderFlows();
      }
    }

    function escapeHtml(text) {
      if (!text) return '';
      return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function getFlowsFromDOM() {
      var container = document.getElementById('flowsContainer');
      var flows = [];
      var divs = container.querySelectorAll(':scope > div');
      for (var i = 0; i < divs.length; i++) {
        var keyInput = divs[i].querySelector('.flow-key');
        var responseInput = divs[i].querySelector('.flow-response');
        if (keyInput && keyInput.value.trim() && responseInput && responseInput.value.trim()) {
          flows.push({ keyword: keyInput.value.trim().toLowerCase(), response: responseInput.value.trim() });
        }
      }
      return flows;
    }

    async function saveAI() {
      var btn = document.getElementById('btnSaveAI');
      var text = document.getElementById('btnSaveAIText');
      var spinner = document.getElementById('btnSaveAISpinner');
      btn.disabled = true;
      text.textContent = 'Salvando...';
      spinner.classList.remove('hidden');
      try {
        var aiActiveToggle = document.getElementById('aiActive');
        var ai_active = aiActiveToggle ? aiActiveToggle.checked : true;
        var auto_flows = getFlowsFromDOM();
        var selectedModelSelect = document.getElementById('selectedModel');
        var selected_model = selectedModelSelect ? selectedModelSelect.value : 'llama-3.3-70b-versatile';
        
        var res = await fetch('/api/settings/save-ai', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            groq_key: document.getElementById('groqKey') ? document.getElementById('groqKey').value : '',
            ai_prompt: document.getElementById('aiPrompt') ? document.getElementById('aiPrompt').value : '',
            ai_active: ai_active,
            auto_flows: auto_flows,
            selected_model: selected_model
          })
        });
        var data = await res.json();
        if (data.success) {
          // Update SERVER_USER with saved values
          SERVER_USER.ai_active = ai_active;
          SERVER_USER.auto_flows = auto_flows;
          SERVER_USER.selected_model = selected_model;
          alert('Configurações Salvas!');
        } else {
          console.error('Erro ao salvar:', data);
          alert('Erro ao salvar configurações');
        }
      } catch(e) {
        console.error('Erro de rede:', e);
        alert('Erro ao salvar configurações');
      } finally {
        btn.disabled = false;
        text.textContent = 'Salvar Todas as Configurações';
        spinner.classList.add('hidden');
      }
    }

    async function subscribe(planType) {
      var btn = event.target;
      var plan = planType || 'pro';
      btn.textContent = 'Gerando PIX...';
      btn.disabled = true;
      try {
        var res = await fetch('/api/subscription/create-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ plan: plan })
        });
        console.log('[subscribe] Status:', res.status);
        var data = await res.json();
        console.log('[subscribe] Resposta:', JSON.stringify(data));
        
        if (data.isAdmin) {
          alert('Conta admin tem acesso permanente!');
          btn.textContent = 'Conta Admin';
          return;
        }
        
        if (data.success && data.checkoutUrl) {
          window.location.href = data.checkoutUrl;
        } else {
          alert(data.error || 'Erro ao gerar checkout. Verifique o console.');
          btn.textContent = 'Tentar novamente';
          btn.disabled = false;
        }
      } catch(e) {
        console.error('[subscribe] Erro:', e);
        alert('Erro de conexão: ' + e.message);
        btn.textContent = 'Tentar novamente';
        btn.disabled = false;
      }
    }

    async function logout() {
      try { await fetch('/api/auth/logout', { method: 'POST' }); } catch(e) {}
      window.location.href = '/';
    }

    var navItems = document.querySelectorAll('.nav-item');
    for (var i = 0; i < navItems.length; i++) {
      navItems[i].addEventListener('click', function(e) {
        e.preventDefault();
        var items = document.querySelectorAll('.nav-item');
        for (var j = 0; j < items.length; j++) {
          items[j].className = 'nav-item flex items-center gap-3 px-4 py-2.5 rounded-xl text-gray-400 hover:bg-white/5 text-sm';
        }
        e.currentTarget.className = 'nav-item flex items-center gap-3 px-4 py-2.5 rounded-xl nav-active text-sm';
        currentPage = e.currentTarget.dataset.page;
        checkSubscription();
      });
    }

    init();
  </script>
