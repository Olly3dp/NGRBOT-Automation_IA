# NGR BOT - variáveis de ambiente (modelo)
# Copie este arquivo para .env e preencha com seus valores reais.

# Administrador master (login do painel)
ADMIN_EMAIL=seu@email.com
ADMIN_PASSWORD=sua-senha-forte

# Segredo das sessões express (gere algo aleatório, ex: openssl rand -hex 32)
SESSION_SECRET=troque-por-um-valor-aleatorio

# Mercado Pago (access token de produção APP_USR-...)
MP_ACCESS_TOKEN=APP_USR-seu-token-aqui

# Chave da API Groq (fallback padrão do bot)
GROQ_API_KEY=gsk_sua-chave-groq

# Porta e ambiente
PORT=3000
NODE_ENV=development